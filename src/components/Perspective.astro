---
// Las líneas en perspectiva (el "pasillo") que unen las cajas.
// inset = cuánto se meten las líneas arriba, en % del ancho.
interface Props {
  inset?: number;
  height?: string;
}
const { inset = 7, height = "4rem" } = Astro.props;
---

<div class="perspective" style={`--h: ${height}`} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none">
    <line x1={inset} y1="0" x2="0" y2="100"></line>
    <line x1={100 - inset} y1="0" x2="100" y2="100"></line>
  </svg>
</div>

<style>
  .perspective { height: var(--h); }
  svg { display: block; width: 100%; height: 100%; overflow: visible; }
  line {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke; /* la línea sigue siendo de 1px aunque el SVG se estire */
  }
  @media (max-width: 700px) {
    .perspective { height: 1.5rem; }
    svg { display: none; }
  }
</style>
